# Google Cloud project that owns the MedGemma endpoint.
# Must be the same project the credentials below authenticate against —
# a mismatch fails at predict() time with a confusing permission error.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI endpoint ID for the deployed MedGemma model (digits only, not the
# full resource path). Get it from Model Garden after deployment, or with:
#   gcloud ai endpoints list --region=us-central1
MEDGEMMA_ENDPOINT_ID=your-medgemma-endpoint-id

# Credentials. Leave GOOGLE_APPLICATION_CREDENTIALS unset to use your own
# gcloud login (recommended for local work):
#   gcloud auth application-default login
# Set it only if you are using a service-account key, and make sure that key
# belongs to GOOGLE_CLOUD_PROJECT above.
# GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

# Perplexity API key (for self-pay cost lookups).
# If unset, costs report as unavailable — they are never estimated locally.
PERPLEXITY_API_KEY=your-perplexity-api-key
